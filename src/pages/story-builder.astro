---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export const prerender = false;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Museum Story Builder</title>

    <style is:global>
      :root {
        color-scheme: dark;
        --ink: oklch(0.13 0.008 264);
        --ink-2: oklch(0.17 0.01 262);
        --ink-3: oklch(0.21 0.012 260);
        --gold: oklch(0.71 0.1 88);
        --gold-2: oklch(0.81 0.09 90);
        --bone: oklch(0.92 0.03 92);
        --bone-2: oklch(0.74 0.03 90);
        --line: oklch(0.71 0.1 88 / 20%);
      }

      body {
        margin: 0;
        padding: 0;
        background: var(--ink);
        color: var(--bone);
        font-family: "Jost", "Avenir Next", Avenir, sans-serif;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      #webmcp-status {
        display: inline-block;
        margin-top: 0.9rem;
        padding: 0.3rem 0.6rem;
        border-radius: 999px;
        border: 1px solid var(--line);
        background: var(--ink-3);
        color: var(--bone-2);
        font-size: 0.78rem;
      }

      #webmcp-status[data-supported="true"] {
        border-color: oklch(0.6 0.12 145 / 60%);
        background: oklch(0.6 0.12 145 / 12%);
        color: oklch(0.78 0.12 145);
      }

      main {
        max-width: 1400px;
        width: 100%;
        margin: 0 auto;
        padding: 2rem;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        flex: 1 0 auto;
      }

      section.panel {
        background: var(--ink-2);
        border: 1px solid var(--line);
        border-radius: 2px;
        padding: 1.5rem;
      }

      section.panel h2 {
        margin: 0 0 1.25rem;
        color: var(--gold);
        font-family: "Cinzel", Georgia, serif;
        font-weight: 500;
        font-size: 1.4rem;
      }

      .panel-group {
        margin-top: 1.25rem;
        padding-top: 1.25rem;
        border-top: 1px solid var(--line);
      }

      .panel-group:first-child {
        margin-top: 0;
        padding-top: 0;
        border-top: none;
      }

      .draft-status-line {
        margin: 1.25rem 0 0;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        margin-bottom: 0.9rem;
      }

      /* Inside a .row, a field's own trailing margin becomes part of its flex-item
         box — align-items: flex-end then aligns to the bottom of that margin, not
         the bottom of the actual input, throwing off alignment with a sibling
         button that has no margin. The row's own gap already spaces things. */
      .row .field {
        margin-bottom: 0;
      }

      .field label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--gold-2);
      }

      input[type="text"],
      input[type="search"],
      select,
      textarea {
        font: inherit;
        padding: 0.65rem 0.85rem;
        border: 1px solid var(--line);
        border-radius: 2px;
        background: var(--ink-3);
        color: inherit;
        transition: border-color 0.15s ease;
      }

      input[type="text"]:hover,
      input[type="search"]:hover,
      select:hover,
      textarea:hover {
        border-color: oklch(0.71 0.1 88 / 45%);
      }

      textarea {
        resize: vertical;
        min-height: 3.5rem;
      }

      input[type="text"]:focus-visible,
      input[type="search"]:focus-visible,
      select:focus-visible,
      textarea:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 1px;
        border-color: var(--gold);
      }

      .item-fields {
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        margin-top: 0.5rem;
        padding-top: 0.6rem;
        border-top: 1px solid var(--line);
      }

      .item-fields .field {
        margin-bottom: 0;
      }

      .item-fields .field-label {
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--gold-2);
      }

      .item-fields input[type="text"],
      .item-fields textarea {
        background: var(--ink);
      }

      .row {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        align-items: flex-end;
      }

      button {
        font: inherit;
        cursor: pointer;
        border: none;
        border-radius: 2px;
        padding: 0.6rem 1rem;
        background: var(--gold);
        color: var(--ink);
      }

      button.secondary {
        background: var(--ink-3);
        color: var(--bone);
        border: 1px solid var(--line);
      }

      button.danger {
        background: transparent;
        color: oklch(0.78 0.12 30);
        border: 1px solid oklch(0.65 0.16 30 / 70%);
      }

      button.danger:hover:not(:disabled) {
        background: oklch(0.65 0.16 30 / 12%);
      }

      button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      button.icon {
        padding: 0.3rem 0.55rem;
        font-size: 0.85rem;
      }

      #draft-status {
        display: inline-block;
        padding: 0.25rem 0.6rem;
        border-radius: 2px;
        background: var(--ink-3);
        color: var(--bone-2);
        font-size: 0.78rem;
        margin-left: 0.5rem;
      }

      #draft-status[data-status="ready_for_review"] {
        background: oklch(0.27 0.045 145);
        color: oklch(0.78 0.12 145);
      }

      #draft-status[hidden] {
        display: none;
      }

      .active-draft-hint {
        margin: 0 0 1.25rem;
        font-size: 0.85rem;
        color: var(--bone-2);
      }

      .active-draft-hint strong {
        color: var(--gold-2);
      }

      .active-draft-hint .hint-warning {
        color: oklch(0.78 0.14 60);
      }

      .active-draft-hint.attention .hint-warning {
        animation: hint-flash 0.4s ease 2;
      }

      @keyframes hint-flash {
        0%,
        100% {
          color: oklch(0.78 0.14 60);
        }
        50% {
          color: oklch(0.88 0.18 60);
        }
      }

      #search-status {
        margin: 0 0 1rem;
        color: var(--bone-2);
        font-size: 0.85rem;
        min-height: 1.2em;
      }

      ol#search-results,
      ol#sequence-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1rem;
      }

      ol#search-results {
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      }

      li.search-card,
      li.sequence-card {
        border: 1px solid var(--line);
        border-radius: 2px;
        overflow: hidden;
        background: var(--ink-3);
        display: flex;
        flex-direction: column;
      }

      li.search-card img,
      li.sequence-card img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        background: var(--ink);
      }

      .card-body {
        padding: 0.7rem;
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
      }

      .card-body h3 {
        margin: 0;
        font-size: 0.95rem;
      }

      .badge {
        font-size: 0.72rem;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
        background: var(--ink);
        color: var(--gold-2);
        width: fit-content;
      }

      li.sequence-card {
        flex-direction: row;
      }

      li.sequence-card img {
        width: 160px;
        height: auto;
        flex-shrink: 0;
      }

      li.sequence-card .card-body {
        flex: 1;
      }

      .move-controls {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 0.7rem 0.4rem;
        justify-content: center;
      }

      #preview-panel[hidden] {
        display: none;
      }

      .story-page {
        max-width: 1400px;
        margin: 0 auto;
      }

      .story-page > h1 {
        color: var(--gold-2);
        font-family: "Cinzel", Georgia, serif;
        font-weight: 500;
        letter-spacing: 0.03em;
        text-align: center;
        margin: 0 0 1.75rem;
      }

      .exhibition-wall {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 1.5rem;
      }

      .frame {
        margin: 0;
        display: flex;
        flex-direction: column;
        background: var(--ink-3);
        border: 1px solid var(--line);
        box-shadow: 0 1rem 2rem oklch(0.05 0.01 264 / 28%);
        padding: 1rem;
      }

      .frame img {
        display: block;
        width: 100%;
        height: 240px;
        object-fit: cover;
        margin: 0 0 0.9rem;
        padding: 0.45rem;
        border: 1px solid oklch(0.71 0.1 88 / 55%);
        box-sizing: border-box;
        background: var(--ink);
      }

      .frame figcaption {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
      }

      .attribution {
        margin: 0;
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--gold-2);
      }

      .plaque-caption {
        margin: 0;
        font-size: 0.85rem;
        font-style: italic;
        color: var(--bone);
      }

      .plaque-narrative {
        margin: 0;
        font-size: 0.85rem;
        color: var(--bone-2);
      }

      .frame a {
        font-size: 0.78rem;
      }

      .preview-panel-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1.5rem;
      }

      .preview-panel-heading h2 {
        margin: 0;
      }

      @media (max-width: 680px) {
        header.masthead {
          padding: 1.5rem 1rem 1rem;
        }

        header.masthead h1 {
          font-size: 2rem;
        }
      }

      /* Printing (including "Save as PDF") shows only the exhibition wall —
         everything else on the page is a working tool, not part of the keepsake.
         Hidden via display:none (not visibility:hidden) so hidden panels don't
         still occupy page height and produce trailing blank pages. */
      @media print {
        header.masthead,
        .site-footer,
        #draft-panel,
        #search-panel,
        #sequence-panel,
        #actions-panel {
          display: none;
        }

        body,
        main {
          background: white;
          padding: 0;
          max-width: none;
        }

        #preview-panel {
          background: white;
          border: none;
          padding: 0;
        }

        .preview-panel-heading {
          display: none;
        }

        .story-page > h1 {
          color: black;
        }

        .exhibition-wall {
          display: block;
          columns: 2;
          column-gap: 1rem;
        }

        .frame {
          display: inline-block;
          width: 100%;
          break-inside: avoid;
          margin: 0 0 1rem;
          background: white;
          border-color: #ccc;
          box-shadow: none;
        }

        .frame img {
          border-color: #999;
        }

        .attribution {
          color: black;
        }

        .plaque-caption,
        .plaque-narrative {
          color: #333;
        }

        .frame a {
          display: none;
        }
      }
    </style>
  </head>

  <body>
    <Header
      title="Museum Story Builder"
      description="Compose a small visual story from your saved museum collection: gather objects, arrange them into a sequence, write captions and narrative text, and view the result as a small exhibition wall. Every action here also works as a WebMCP tool a supporting browser agent can call directly."
      current="story-builder"
    >
      <div id="webmcp-status" role="status" aria-live="polite"></div>
    </Header>

    <main>
      <section class="panel" id="draft-panel">
        <h2>1. Story draft</h2>

        <div class="panel-group">
          <div class="row">
            <div class="field">
              <label for="draft-select">Existing drafts</label>
              <select id="draft-select"></select>
            </div>
            <button id="delete-draft-button" type="button" class="danger" disabled>Delete draft</button>
          </div>
        </div>

        <div class="panel-group">
          <form id="new-draft-form">
            <div class="row">
              <div class="field">
                <label for="draft-title">Title</label>
                <input id="draft-title" type="text" maxlength="140" required />
              </div>
              <button type="submit">Create draft</button>
            </div>
          </form>
        </div>

        <p class="draft-status-line">
          Status: <strong id="draft-title-display">No draft selected</strong>
          <span id="draft-status" data-status="draft">draft</span>
        </p>
      </section>

      <section class="panel" id="search-panel">
        <h2>2. Search your saved collection</h2>
        <p id="search-active-draft" class="active-draft-hint"></p>

        <form id="search-form">
          <div class="row">
            <div class="field">
              <label for="search-query">Artist or keyword</label>
              <input id="search-query" type="search" placeholder="Monet, textiles, migration…" />
            </div>
            <div class="field">
              <label for="search-source">Source</label>
              <select id="search-source">
                <option value="">All</option>
                <option value="met">The Met</option>
                <option value="artic">Art Institute of Chicago</option>
                <option value="cleveland">Cleveland Museum of Art</option>
              </select>
            </div>
            <button type="submit">Search</button>
          </div>
        </form>

        <p id="search-status" role="status" aria-live="polite"></p>
        <ol id="search-results"></ol>
      </section>

      <section class="panel" id="sequence-panel">
        <h2>3. Narrative sequence</h2>
        <p>Use the arrows to reorder. Each item's title is used as its image's alt text automatically.</p>
        <ol id="sequence-list"></ol>
      </section>

      <section class="panel" id="preview-panel" hidden>
        <div class="preview-panel-heading">
          <h2>4. Exhibition preview</h2>
          <button id="download-pdf-button" type="button" class="secondary">Download as PDF</button>
        </div>
        <div id="preview-content" class="story-page"></div>
      </section>

      <section class="panel" id="actions-panel">
        <h2>5. Review</h2>

        <div class="row">
          <button id="preview-button" type="button" class="secondary">View exhibition</button>
          <button id="request-review-button" type="button">Mark ready for review</button>
        </div>

        <p id="review-message" role="status"></p>
      </section>
    </main>

    <Footer />

    <script>
      import { mountStoryBuilder } from "../lib/client/storyBuilderController";
      mountStoryBuilder();
    </script>
  </body>
</html>
