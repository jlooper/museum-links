---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

export const prerender = false;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Museum Media Grouper</title>

    <style is:global>
      :root {
        --ink: oklch(0.13 0.008 264);
        --ink-2: oklch(0.17 0.01 262);
        --ink-3: oklch(0.21 0.012 260);
        --gold: oklch(0.71 0.1 88);
        --gold-2: oklch(0.81 0.09 90);
        --bone: oklch(0.92 0.03 92);
        --bone-2: oklch(0.74 0.03 90);
        --line: oklch(0.71 0.1 88 / 20%);
        --space-xs: 0.5rem;
        --space-sm: 0.9rem;
        --space-md: 1.5rem;
        --space-lg: 2.5rem;
        --space-xl: 4rem;
      }

      body {
        margin: 0;
        padding: 0;
        background: var(--ink);
        color: var(--bone);
        font-family: "Jost", "Avenir Next", Avenir, sans-serif;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }

      main {
        max-width: 1400px;
        width: 100%;
        margin: 0 auto;
        padding: clamp(1rem, 3vw, 2.5rem) clamp(1rem, 3vw, 2.5rem) 6rem;
        box-sizing: border-box;
        flex: 1 0 auto;
      }

      #search-form {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
        align-items: flex-end;
        margin-bottom: var(--space-sm);
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 0.3rem;
      }

      .field label {
        font-size: 0.85rem;
        font-weight: 600;
        color: var(--bone-2);
      }

      #search-query {
        width: 100%;
        min-width: 18rem;
        max-width: 34rem;
        padding: 1rem;
        border-radius: 12px;
        border: 1px solid var(--line);
        font-size: 1rem;
        font: inherit;
      }

      #search-source {
        font: inherit;
        padding: 0.65rem 0.7rem;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: var(--ink-3);
        color: inherit;
      }

      #search-form button {
        font: inherit;
        cursor: pointer;
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.2rem;
        background: var(--gold);
        color: var(--ink);
        font-weight: 600;
      }

      #search-form button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      #search-query:focus-visible,
      #search-source:focus-visible,
      #search-form button:focus-visible,
      #save-button:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 1px;
      }

      .result-image-wrap input[type="checkbox"]:focus-visible {
        outline: 2px solid var(--gold);
        outline-offset: 2px;
      }

      #search-status {
        margin: 0 0 var(--space-lg);
        color: var(--bone-2);
        min-height: 1.2em;
      }

      ol#search-results {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 18rem));
        gap: var(--space-lg) var(--space-md);
      }

      li.result-card {
        min-width: 0;
        height: 34rem;
        background: var(--ink-2);
        border: 1px solid var(--line);
        border-radius: 2px;
        overflow: hidden;
        box-shadow: 0 1rem 2rem oklch(0.05 0.01 264 / 28%);
        display: flex;
        flex-direction: column;
        cursor: pointer;
        transition: transform 0.25s ease, border-color 0.25s ease;
      }

      li.result-card:hover {
        transform: translateY(-4px);
        border-color: oklch(0.81 0.09 90 / 60%);
      }

      li.result-card.selected {
        border-color: var(--gold);
        box-shadow: 0 0 0 2px var(--gold), 0 1rem 2rem oklch(0.05 0.01 264 / 28%);
      }

      li.result-card.saved {
        cursor: default;
        opacity: 0.6;
      }

      .result-image-wrap {
        position: relative;
        height: 19rem;
        flex-shrink: 0;
        background: var(--ink-3);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
      }

      .result-image-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        margin: 0;
        padding: 0.45rem;
        border: 1px solid oklch(0.71 0.1 88 / 55%);
        box-sizing: border-box;
      }

      .result-image-wrap input[type="checkbox"] {
        position: absolute;
        top: 0.75rem;
        right: 0.75rem;
        width: 1.4rem;
        height: 1.4rem;
        accent-color: var(--gold);
        pointer-events: none;
      }

      .saved-badge {
        position: absolute;
        top: 0.75rem;
        left: 0.75rem;
        padding: 0.3rem 0.6rem;
        border-radius: 2px;
        background: var(--gold);
        color: var(--ink);
        font-size: 0.78rem;
        font-weight: 700;
      }

      .card-body {
        min-height: 0;
        padding: var(--space-md);
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
        overflow: hidden;
      }

      .card-body h3 {
        margin: 0;
        line-height: 1.3;
      }

      .card-body p {
        margin: 0;
        color: var(--bone-2);
      }

      .badge {
        display: inline-block;
        padding: 0.3rem 0.7rem;
        border-radius: 999px;
        background: var(--ink-3);
        color: var(--gold-2);
        font-size: 0.8rem;
        width: fit-content;
      }

      a {
        color: var(--gold-2);
        text-decoration: none;
      }

      a:hover {
        text-decoration: underline;
      }

      #save-bar {
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        align-items: center;
        gap: var(--space-md);
        padding: 1rem clamp(1rem, 3vw, 2.5rem);
        background: var(--ink-2);
        border-top: 1px solid var(--line);
        box-shadow: 0 -0.5rem 1.5rem oklch(0.05 0.01 264 / 40%);
        z-index: 10;
      }

      #save-bar[hidden] {
        display: none;
      }

      #save-button {
        font: inherit;
        cursor: pointer;
        border: none;
        border-radius: 8px;
        padding: 0.75rem 1.2rem;
        background: var(--gold);
        color: var(--ink);
        font-weight: 600;
      }

      #save-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
      }

      #save-result {
        margin: var(--space-md) 0 0;
      }

      .save-success {
        color: var(--bone);
      }

      .save-failed {
        color: oklch(0.78 0.12 30);
      }

      @media (max-width: 36rem) {
        #search-form {
          flex-direction: column;
          align-items: stretch;
        }
      }
    </style>
  </head>

  <body>
    <Header
      title="Museum Media Grouper"
      description="Search the Met, the Art Institute of Chicago, and the Cleveland Museum of Art at once. Nothing is saved until you pick the paintings you want and add them to your gallery."
      current="home"
    />

    <main>
      <form id="search-form">
        <div class="field">
          <label for="search-query">Artist or keyword</label>
          <input id="search-query" type="search" placeholder="Monet, textiles, portrait…" required />
        </div>
        <div class="field">
          <label for="search-source">Museum</label>
          <select id="search-source">
            <option value="">All museums</option>
            <option value="met">The Met</option>
            <option value="artic">Art Institute of Chicago</option>
            <option value="cleveland">Cleveland Museum of Art</option>
          </select>
        </div>
        <button type="submit">Search</button>
      </form>

      <p id="search-status" role="status" aria-live="polite"></p>

      <ol id="search-results"></ol>

      <div id="save-result"></div>
    </main>

    <Footer />

    <div id="save-bar" hidden>
      <span><strong id="selected-count">0</strong> selected</span>
      <button id="save-button" type="button" disabled>Save selected to my gallery</button>
    </div>

    <script>
      import { mountMuseumSearch } from "../lib/client/museumSearchController";
      mountMuseumSearch();
    </script>
  </body>
</html>
